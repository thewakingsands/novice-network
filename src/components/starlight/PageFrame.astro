---
// 覆盖 Starlight PageFrame：复刻原 Layout.vue 页面骨架。
import PhotoSwipeMount from '@/components/theme/PhotoSwipeMount.astro'
import eorzeaMapScriptUrl from '@thewakingsands/eorzea-interactive-map/dist/map.js?url'
const { entry } = Astro.locals.starlightRoute
const className = entry.data.className
const isWebframe = !!entry.data.webframe
---

<div id="root" class:list={['root-container', className]}>
  <div class="main-container">
    <nav class="nav-menu">
      <slot name="sidebar" />
    </nav>
    <div class:list={['content-outer', { fullscreen: isWebframe }]}>
      <div class="content-inner">
        <slot name="header" />
        <slot />
      </div>
    </div>
  </div>
  <PhotoSwipeMount />
</div>

<script is:inline src={eorzeaMapScriptUrl}></script>

<script>
  // 复刻原 Layout.vue：初始化技能/状态悬浮详情（读取 data-ck-action-id 等属性）
  import('@thewakingsands/kit-tooltip')
    .then((x) => x.initTooltip())
    .catch(() => {})
</script>

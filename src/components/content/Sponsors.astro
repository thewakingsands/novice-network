---
import { fetchSponsors, type Sponsor } from '@/utils/afdian'

let sponsors: Sponsor[] = []
let loadFailed = false
const userId = process.env.AFDIAN_USER_ID
const apiToken = process.env.AFDIAN_API_TOKEN

if (userId && apiToken) {
  try {
    sponsors = await fetchSponsors(userId, apiToken)
  } catch (cause) {
    loadFailed = true
    console.warn('[afdian] 构建期获取赞助者失败', cause)
  }
} else {
  loadFailed = true
}
---

<div class="sponsors-container">
  <div class="sponsors-header">感谢以下赞助者：</div>
  {
    sponsors.length > 0 ? (
      <ul class="sponsors">
        {sponsors.map((sponsor) => (
          <li class="sponsor">
            <div class="sponsor-avatar">
              <img
                class="no-zoom"
                src={sponsor.avatar}
                alt={sponsor.sponsor}
                loading="lazy"
              />
            </div>
            <div class="sponsor-name">{sponsor.sponsor}</div>
          </li>
        ))}
      </ul>
    ) : (
      loadFailed && <div class="sponsor-error">赞助者名单暂时无法获取。</div>
    )
  }
  <div class="sponsors-footer">
    <a
      href="https://afdian.com/a/hikarievo"
      target="_blank"
      rel="noopener noreferrer"
    >点我发电</a>
  </div>
</div>

<style lang="scss" is:global>
.sponsors-container {
  .sponsors {
    list-style: none;
    white-space: nowrap;
    overflow-x: auto;
    padding-left: 0;
  }
  .sponsor {
    display: inline-block;
    width: 128px;
    padding: 8px;
    text-align: center;
  }
  .sponsor-name {
    width: 100%;
    text-overflow: ellipsis;
    overflow: hidden;
    font-size: 0.9em;
  }
  .sponsor-avatar img {
    width: 48px;
    height: 48px;
    border-radius: 100%;
    overflow: hidden;
    object-fit: cover;
  }
  .sponsor-error {
    color: #db2828;
  }
}
</style>

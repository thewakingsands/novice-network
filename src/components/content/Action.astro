---
// 复刻 Action.vue：技能图标 + 名称。构建期经 XIVAPI v2 烘焙图标与 action id（失败降级为占位）。
import { searchAction } from '@/utils/xivapi'

interface Props {
  name?: string
  id?: number
  job?: string
  noname?: boolean
  cls?: string
}
const { name = '', id, job, noname, cls } = Astro.props

// 职业名 → jobId（移植 Action.vue 的 jobList）
const JOB_LIST: Record<string, number> = {
  冒险者: 0, 剑术师: 1, 格斗家: 2, 斧术师: 3, 枪术师: 4, 弓箭手: 5, 幻术师: 6,
  咒术师: 7, 刻木匠: 8, 锻铁匠: 9, 铸甲匠: 10, 雕金匠: 11, 制革匠: 12, 裁衣匠: 13,
  炼金术士: 14, 烹调师: 15, 采矿工: 16, 园艺工: 17, 捕鱼人: 18, 骑士: 19, 武僧: 20,
  战士: 21, 龙骑士: 22, 吟游诗人: 23, 白魔法师: 24, 黑魔法师: 25, 秘术师: 26,
  召唤师: 27, 学者: 28, 双剑师: 29, 忍者: 30, 机工士: 31, 暗黑骑士: 32,
  占星术士: 33, 武士: 34, 赤魔法师: 35, 青魔法师: 36, 绝枪战士: 37, 舞者: 38,
  钐镰客: 39, 贤者: 40, 蝰蛇剑士: 41, 绘灵法师: 42,
}
const pageJob = Astro.locals.starlightRoute?.entry?.data?.jobName as
  | string
  | undefined
const jobId = job ? JOB_LIST[job] : pageJob ? JOB_LIST[pageJob] : null

const result = await searchAction(name, id, jobId)
const iconUrl = result?.iconUrl
const actionId = result?.id ?? id
---

<strong data-ck-action-id={actionId} class:list={['action', cls]}>
  <span class="action-container">
    <img
      src={iconUrl || 'about:blank'}
      class:list={['no-zoom', { hide: !iconUrl }]}
      alt=""
    />
  </span>{!noname && <slot>{name}</slot>}
</strong>

<style lang="scss">
:global(.cap) .action-container {
  margin-left: -1em;
  margin-bottom: -0.1em;
  vertical-align: bottom;
}
img {
  vertical-align: bottom;
  width: 1em;
  height: 1em;
  cursor: pointer !important;
  &.hide {
    visibility: hidden;
  }
}
.action-container {
  margin-left: 0.2em;
  margin-bottom: 0.2em;
  display: inline-block;
  position: relative;
  line-height: 1em;
  &::before {
    content: '';
    width: 100%;
    height: 100%;
    position: absolute;
    top: 0;
    left: 0;
    border-radius: 15%;
    pointer-events: none;
    background: radial-gradient(
      circle at 50% -430%,
      rgba(255, 255, 255, 0.6) 70%,
      rgba(255, 255, 255, 0) 65%
    );
    box-shadow:
      inset 0px 4px 4px 2px rgba(255, 255, 255, 0.3),
      inset 0px -2px 4px 2px rgba(255, 255, 255, 0.1);
  }
}
</style>

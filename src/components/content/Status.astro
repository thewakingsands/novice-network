---
// 复刻 Status.vue：状态效果图标 + 名称。构建期经 XIVAPI v2 烘焙图标与描述（失败降级为占位）。
import { searchStatus } from '@/utils/xivapi'

interface Props {
  name?: string
  id?: number
  dispel?: boolean
  stack?: number
}
const { name = '', id, dispel, stack = 0 } = Astro.props

const result = id !== undefined ? await searchStatus(id, stack) : null
const iconUrl = result?.iconUrl
const description = result?.description || ''
---

<strong class:list={['status', dispel && 'dispel']} title={description}>
  <img
    src={iconUrl || 'about:blank'}
    class:list={['no-zoom', { hide: !iconUrl }]}
    alt=""
  />
  <slot>{name}</slot>
</strong>

<style lang="scss">
.status.dispel::before {
  content: '';
  width: 20px;
  height: 2px;
  background: #dfedff;
  position: absolute;
  margin-left: calc(0.25em + 1px);
  border-radius: 2px;
  box-shadow: 0 0 1px 1px #65c6ff;
}
img {
  vertical-align: middle;
  width: 1.3em;
  height: 1.3em;
  margin-left: 0.2em;
  cursor: pointer !important;
  &.hide {
    visibility: hidden;
  }
}
</style>

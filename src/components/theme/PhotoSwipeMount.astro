---
// PhotoSwipe v4 灯箱：复刻原 PhotoSwipe.vue。正文内 <img>（无 .no-zoom）点击打开单图画廊。
---

<div class="pswp" tabindex="-1" role="dialog" aria-hidden="true" data-pswp-root>
  <div class="pswp__bg"></div>
  <div class="pswp__scroll-wrap">
    <div class="pswp__container">
      <div class="pswp__item"></div>
      <div class="pswp__item"></div>
      <div class="pswp__item"></div>
    </div>
    <div class="pswp__ui pswp__ui--hidden">
      <div class="pswp__top-bar">
        <div class="pswp__counter"></div>
        <button class="pswp__button pswp__button--close" title="关闭（Esc）"></button>
        <button class="pswp__button pswp__button--fs" title="全屏"></button>
        <button class="pswp__button pswp__button--zoom" title="缩放"></button>
        <div class="pswp__preloader">
          <div class="pswp__preloader__icn">
            <div class="pswp__preloader__cut">
              <div class="pswp__preloader__donut"></div>
            </div>
          </div>
        </div>
      </div>
      <div class="pswp__share-modal pswp__share-modal--hidden pswp__single-tap">
        <div class="pswp__share-tooltip"></div>
      </div>
      <button class="pswp__button pswp__button--arrow--left" title="上一张（左箭头）"></button>
      <button class="pswp__button pswp__button--arrow--right" title="下一张（右箭头）"></button>
      <div class="pswp__caption"><div class="pswp__caption__center"></div></div>
    </div>
  </div>
</div>

<script>
  import PhotoSwipe from 'photoswipe/dist/photoswipe'
  import PhotoSwipeUIDefault from 'photoswipe/dist/photoswipe-ui-default'
  import 'photoswipe/dist/photoswipe.css'
  import 'photoswipe/dist/default-skin/default-skin.css'

  const pswpEl = document.querySelector<HTMLElement>('[data-pswp-root]')
  let instance: any = null

  function openSingle(url: string, el: HTMLImageElement) {
    if (!pswpEl) return
    if (instance) {
      try {
        instance.destroy()
      } catch {}
    }
    const width = el.naturalWidth || 1024
    const height = el.naturalHeight || 1024
    instance = new (PhotoSwipe as any)(
      pswpEl,
      PhotoSwipeUIDefault,
      [{ src: url, w: width * 2 || 1000, h: height * 2 || 1000 }],
      { index: 0, history: false }
    )
    instance.init()
  }

  // 事件委托：正文内 <img>（无 .no-zoom）点击打开灯箱
  document.addEventListener('click', (e) => {
    let el = e.target as HTMLElement | null
    while (el && el.tagName !== 'IMG' && el.tagName !== 'A') el = el.parentElement
    if (!el || el.tagName !== 'IMG') return
    const img = el as HTMLImageElement
    if (img.classList.contains('no-zoom')) return
    if (!img.closest('.content-container-inner')) return
    openSingle(img.src, img)
  })
</script>

---
// 复刻 ContentContainer 右侧 sticky 文章目录 + “回到页首”。
const { headings } = Astro.locals.starlightRoute
const items = (headings ?? [])
  .filter((heading) => heading.depth >= 2 && heading.depth <= 3)
  .reduce<
    Array<{
      heading: (typeof headings)[number]
      children: Array<(typeof headings)[number]>
    }>
  >((groups, heading) => {
    if (heading.depth === 2 || groups.length === 0) {
      groups.push({ heading, children: [] })
    } else {
      groups[groups.length - 1].children.push(heading)
    }
    return groups
  }, [])
---

{
  items.length > 0 && (
    <aside class="hide-small">
      <div class="articleTOC" data-anchor-scroll>
        <ul>
          {items.map(({ heading, children }) => (
            <li>
              <a href={`#${heading.slug}`}>{heading.text}</a>
              {children.length > 0 && (
                <ul>
                  {children.map((child) => (
                    <li>
                      <a href={`#${child.slug}`}>{child.text}</a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))}
        </ul>
      </div>
      <a href="#" data-top>
        <i class="double up angle icon" /> 回到页首
      </a>
    </aside>
  )
}

<script>
  import { bindAnchorScroll, gotoId } from '@/scripts/gotoId'
  const aside = document.querySelector('[data-anchor-scroll]')
  if (aside) bindAnchorScroll(aside)
  document.querySelector('[data-top]')?.addEventListener('click', (e) => {
    e.preventDefault()
    gotoId('')
  })
</script>
